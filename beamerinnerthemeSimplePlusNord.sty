%% ---------------------------------------------------------------------------
%% Geometry, and the switch that makes one slide dark
%% ---------------------------------------------------------------------------

\setbeamersize{text margin left=3em,text margin right=3em}
\setbeamertemplate{navigation symbols}{}

% The background and the bottom of a slide are drawn after the body of its frame, outside the
% group of the body: a setting made inside the frame cannot reach them. The title slide and
% \darkslide therefore raise a global flag, which is lowered again when the next frame starts.
\newif\ifsplusnord@dark
\addtobeamertemplate{background canvas}{}{%
    \ifsplusnord@dark\hskip-\paperwidth\color{nord0}\vrule width\paperwidth height\paperheight\fi}

% Optional: \darkslide, right after \begin{frame}, gives any slide the dark look of the title slide.
\newcommand\darkslide{%
    \global\splusnord@darktrue
    \setbeamercolor{normal text}{fg=nord6}\setbeamercolor{structure}{fg=nord6}%
    \setbeamercolor{section in toc}{fg=nord6}\setbeamercolor{subsection in toc}{fg=nord4}%
    \color{nord6}}

%% ---------------------------------------------------------------------------
%% Title slide: dark, title on the left, who and when at the bottom right
%% ---------------------------------------------------------------------------

\setbeamertemplate{title page}{%
    \global\splusnord@darktrue
    \vspace{8em}
    \begingroup
    \begin{beamercolorbox}[sep=0pt,left]{title}
        \usebeamerfont{title}\inserttitle\par
        \ifx\insertsubtitle\@empty\else
            \vskip0.25em
            {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertsubtitle\par}
        \fi
    \end{beamercolorbox}
    \vskip1em
    \hbox{\color{nord10}\vrule width 3em height 3pt}
    \vskip0.75em
    {\usebeamercolor[fg]{titlegraphic}\inserttitlegraphic\par}
    % filll wins over the vfill that Beamer adds above and below a centred frame
    \vskip0pt plus 1filll
    \begin{beamercolorbox}[sep=0pt,right]{author}
        \usebeamerfont{author}\insertauthor
    \end{beamercolorbox}
    \vskip0.25em
    \begin{beamercolorbox}[sep=0pt,right]{institute}
        \usebeamerfont{institute}\insertinstitute
    \end{beamercolorbox}
    \vskip0.5em
    \begin{beamercolorbox}[sep=0pt,right]{date}
        \usebeamerfont{date}\insertdate
    \end{beamercolorbox}
    % the strip of the footline is reserved under the text even though this slide has none
    \vskip\dimexpr\beamer@leftmargin-\footheight\relax
    \endgroup}

%% ---------------------------------------------------------------------------
%% Every other slide: the title in a dark band, a progress strip at the bottom
%% ---------------------------------------------------------------------------

\setbeamertemplate{frametitle}{%
    % Beamer leaves 1pt above the title: pull the band up to the edge of the page
    \vskip-1pt
    \begin{beamercolorbox}[wd=\paperwidth,ht=21pt,dp=11pt,left]{frametitle}
        \leftskip=\beamer@leftmargin
        \rightskip=\beamer@rightmargin
        \usebeamerfont{frametitle}\insertframetitle\par
    \end{beamercolorbox}}

% \source{...}: an entry in the source line at the bottom left, level with the page number.
% Several calls on one slide are joined with semicolons.
\newcount\splusnord@nsrc
\def\splusnord@source{}
\newcommand\source[1]{%
    \ifnum\splusnord@nsrc=0
        \gdef\splusnord@source{#1}%
    \else
        \g@addto@macro\splusnord@source{; #1}%
    \fi
    \global\advance\splusnord@nsrc by 1\relax}

% What a new frame starts from: a light slide with no sources
\AddToHook{env/frame/begin}{%
    \global\splusnord@darkfalse
    \gdef\splusnord@source{}\global\splusnord@nsrc=0\relax}

% Page number and sources above a strip that fills up with the deck. The title slide has neither.
\setbeamertemplate{footline}{%
    \ifsplusnord@dark\else
    \vbox{%
        \hbox to\paperwidth{\hskip\beamer@leftmargin
            % the sources stop 6em short of the number: a longer list is reported as overfull
            \hbox to\dimexpr\paperwidth-2\beamer@leftmargin-6em\relax{%
                \usebeamerfont{source}\usebeamercolor[fg]{source}%
                \ifnum\splusnord@nsrc>0
                    \ifnum\splusnord@nsrc>1 Sources\else Source\fi: \splusnord@source
                \fi\hfill}\hfill
            {\usebeamerfont{page number current}\usebeamercolor[fg]{page number current}\insertframenumber}%
            {\usebeamerfont{page number current}\usebeamercolor[fg]{page number total}\thinspace/\thinspace}%
            {\usebeamerfont{page number total}\usebeamercolor[fg]{page number total}\inserttotalframenumber}%
            \kern8pt}%
        \nointerlineskip\vskip3pt
        \hbox to\paperwidth{%
            {\color{nord4}\vrule width\paperwidth height 3pt}%
            \hskip-\paperwidth
            {\color{nord10}\vrule height 3pt
                width \dimexpr\paperwidth*\insertframenumber/%
                    \ifnum\inserttotalframenumber>0 \inserttotalframenumber\else 1\fi\relax}%
            \hss}}%
    \fi}

% \fade[percent]{...} lightens everything inside by mixing every colour with nord6, the slide colour
% (default 40: 40% of the colour stays). Beamer's own \opaqueness does this but only inside
% \uncover, so the colour mixin behind it is used directly. Colours set inside the argument fade too.
\newcommand\fade[2][40]{{%
    \edef\beamer@colorhook{!#1!nord6\beamer@colorhook}%
    \def\beamer@pgfextension{!#1opaque}%
    \color{.}#2}}

%% ---------------------------------------------------------------------------
%% Boxes: tcolorbox draws them because Beamer fixes the corner radius in a macro
%% ---------------------------------------------------------------------------

\RequirePackage{tcolorbox}
\tcbuselibrary{skins}

% #1 is empty, " alerted" or " example": it picks the matching Beamer colours
\newcommand\splusnord@boxbegin[1]{%
    \usebeamercolor[bg]{block title#1}\colorlet{splusnord@tbg}{bg}%
    \usebeamercolor[fg]{block title#1}\colorlet{splusnord@tfg}{fg}%
    \usebeamercolor[bg]{block body#1}\colorlet{splusnord@bbg}{bg}%
    \usebeamercolor[fg]{block body#1}\colorlet{splusnord@bfg}{fg}%
    \begin{tcolorbox}[enhanced,arc=2pt,boxrule=0.6pt,colframe=splusnord@tbg,
        colback=splusnord@bbg,colbacktitle=splusnord@tbg,coltitle=splusnord@tfg,
        colupper=splusnord@bfg,title={\insertblocktitle},
        fonttitle=\usebeamerfont*{block title#1},fontupper=\usebeamerfont*{block body#1},
        left=3pt,right=3pt,top=2pt,bottom=2pt,toptitle=0pt,bottomtitle=0pt,
        lefttitle=3pt,righttitle=3pt,before skip=4pt,after skip=4pt]}
\setbeamertemplate{block begin}{\splusnord@boxbegin{}}
\setbeamertemplate{block alerted begin}{\splusnord@boxbegin{ alerted}}
\setbeamertemplate{block example begin}{\splusnord@boxbegin{ example}}
\setbeamertemplate{block end}{\end{tcolorbox}}
\setbeamertemplate{block alerted end}{\end{tcolorbox}}
\setbeamertemplate{block example end}{\end{tcolorbox}}

% The names an author uses. Not "box": an environment of that name would redefine TeX's \box.
\newenvironment<>{infobox}[1]{\begin{block}#2{#1}}{\end{block}}
\newenvironment<>{alertbox}[1]{\begin{alertblock}#2{#1}}{\end{alertblock}}
\newenvironment<>{examplebox}[1]{\begin{exampleblock}#2{#1}}{\end{exampleblock}}

% Theorems, definitions, lemmas and examples are boxes. A proof has none of its own: it is run-in
% text, so that it can sit inside the box of its theorem.
\setbeamertemplate{proof begin}{%
    \par\vskip\smallskipamount\noindent{\bfseries\itshape\insertproofname}\ }
\setbeamertemplate{proof end}{\par}

%% ---------------------------------------------------------------------------
%% Lists, tables, captions, figures and references
%% ---------------------------------------------------------------------------

\setbeamertemplate{itemize item}{\usebeamercolor[fg]{item}\raisebox{0.9pt}{\tiny$\blacktriangleright$}}
\setbeamertemplate{itemize subitem}{\usebeamercolor[fg]{item}\raisebox{0.7pt}{\tiny$\triangleright$}}

% Tables: roomy rows and columns, hairlines (\hline) between rows, and under the header the line
% \headrule. There is no rule above or below the table. The line sits 0.5pt under the middle of
% the gap: by the baseline of the header it belongs in the middle, by its descenders lower.
% colortbl colours the rules, booktabs gives \specialrule
\RequirePackage{colortbl}
\RequirePackage{booktabs}
\AddToHook{env/table/begin}{%
    \renewcommand\arraystretch{1.4}\setlength\tabcolsep{9pt}\setlength\arrayrulewidth{0.5pt}%
    \arrayrulecolor{nord4}}
\newcommand\headrule{\arrayrulecolor{nord3}\specialrule{1pt}{0.5pt}{-0.5pt}\arrayrulecolor{nord4}}
\setbeamertemplate{caption}[numbered]

% The label of a reference is its number, as in the numeric citations of the text
\setbeamertemplate{bibliography item}[text]

% \roundedgraphics[options]{file}: an opaque picture with rounded corners (3pt), clipped and not just
% framed. A picture with a transparent background needs only \includegraphics.
\newbox\splusnord@imagebox
\newcommand\roundedgraphics[2][]{%
    \setbox\splusnord@imagebox=\hbox{\includegraphics[#1]{#2}}%
    \begin{tikzpicture}
        \clip[rounded corners=3pt] (0,0) rectangle (\wd\splusnord@imagebox,\ht\splusnord@imagebox);
        \node[anchor=south west,inner sep=0pt,outer sep=0pt] at (0,0) {\box\splusnord@imagebox};
    \end{tikzpicture}}

%% ---------------------------------------------------------------------------
%% Overview
%% ---------------------------------------------------------------------------

\setbeamertemplate{section in toc}{\leavevmode\inserttocsection\par}
\setbeamertemplate{subsection in toc}{%
    \leavevmode\leftskip=0.8em\inserttocsubsection\par\vskip0.25em}

% Optional: \tocnumbers numbers the entries (1., 1.1). In the preamble it holds for the whole deck,
% inside a frame for that slide only.
\newcommand\tocnumbers{%
    \setbeamertemplate{section in toc}[sections numbered]%
    \setbeamertemplate{subsection in toc}{%
        \leavevmode\leftskip=3.2em
        \rlap{\hskip-2em\inserttocsectionnumber.\inserttocsubsectionnumber}%
        \inserttocsubsection\par}}

% \sectioncolumns: the overview with one column per section, for decks of a few sections.
% \sectioncolumns[current] keeps the running section as it is and fades the others. The number of
% sections is known only at the end of a run, so it goes into the .aux file for the next run
% (the first run shows one column).
\newcount\splusnord@i
\AtEndDocument{\immediate\write\@auxout{\string\gdef\string\splusnordnsec{\the\c@section}}}
\providecommand\splusnordnsec{1}
\newcommand\sectioncolumns[1][all]{%
    \def\splusnord@mode{#1}%
    \begin{columns}[T,onlytextwidth]%
        \splusnord@i=1\relax%
        \@whilenum\splusnord@i<\numexpr\splusnordnsec+1\relax\do{%
            \begin{column}{\dimexpr0.97\textwidth/\splusnordnsec\relax}%
                \begingroup%
                \def\splusnord@current{current}%
                \setbeamercolor{section in toc}{fg=nord3}%
                \setbeamercolor{subsection in toc}{fg=nord3}%
                \ifx\splusnord@mode\splusnord@current%
                    \ifnum\splusnord@i=\value{section}%
                        \tableofcontents[sections={\the\splusnord@i}]%
                    \else%
                        \fade{\tableofcontents[sections={\the\splusnord@i}]}%
                    \fi%
                \else%
                    \tableofcontents[sections={\the\splusnord@i}]%
                \fi%
                \endgroup%
            \end{column}%
            \global\advance\splusnord@i by 1\relax}%
    \end{columns}}

%% ---------------------------------------------------------------------------
%% Code boxes. The frame has to be [fragile]; they use the listings package through tcolorbox.
%% ---------------------------------------------------------------------------

\tcbuselibrary{listings}
\tcbset{splusnord code/.style={enhanced,arc=2pt,boxrule=0.6pt,colframe=nord3,
    colback=nord6!95!nord3,colupper=nord0,
    listing options={language={[LaTeX]TeX},basicstyle=\ttfamily\footnotesize\color{nord0},
        texcsstyle=*\color{nord10},commentstyle=\color{nord3},breaklines=true,columns=fullflexible},
    left=3pt,right=3pt,top=3pt,bottom=3pt,before skip=4pt,after skip=4pt}}
% codeonly: the code, not run. codeexample: the code on the left, what it makes on the right.
\newtcblisting{codeonly}{splusnord code,listing only}
\newtcblisting{codeexample}{splusnord code,listing side text,lefthand width=0.52\linewidth,
    sidebyside gap=6pt,sidebyside align=top}
